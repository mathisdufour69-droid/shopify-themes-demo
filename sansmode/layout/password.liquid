<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ settings.brand_name | default: 'SANSMODÉ' }} &ndash; Bientôt</title>
    {{ 'fredoka-latin-700-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: 'Fredoka'; font-weight: 700; font-display: swap; src: url('{{ 'fredoka-latin-700-normal.woff2' | asset_url }}') format('woff2'); }
      @font-face { font-family: 'Fredoka'; font-weight: 600; font-display: swap; src: url('{{ 'fredoka-latin-600-normal.woff2' | asset_url }}') format('woff2'); }
      @font-face { font-family: 'Nunito'; font-weight: 400; font-display: swap; src: url('{{ 'nunito-latin-400-normal.woff2' | asset_url }}') format('woff2'); }
      @font-face { font-family: 'Nunito'; font-weight: 800; font-display: swap; src: url('{{ 'nunito-latin-800-normal.woff2' | asset_url }}') format('woff2'); }
      :root { --violet: {{ settings.color_violet }}; --jaune: {{ settings.color_jaune }}; --turquoise: {{ settings.color_turquoise }}; --rouge: {{ settings.color_rouge }}; --rose: {{ settings.color_rose }}; --creme: {{ settings.color_creme }}; --encre: {{ settings.color_encre }}; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
