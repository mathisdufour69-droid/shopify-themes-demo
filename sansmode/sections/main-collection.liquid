{%- paginate collection.products by 24 -%}
<section class="grid-sec">
  <div class="container">
    <div class="sec-head">
      <p class="kicker">{{ collection.products_count }} produit{% if collection.products_count > 1 %}s{% endif %}</p>
      <h1 class="h2">{% if collection.handle == 'all' %}{{ section.settings.all_title }}{% else %}{{ collection.title }}{% endif %}</h1>
      {%- if collection.description != blank -%}<div class="sec-head__text rte">{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- if collection.sort_options.size > 0 -%}
      <form class="sort" method="get">
        <label for="SortBy">Trier</label>
        <select id="SortBy" name="sort_by" class="input input--select" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}<option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>{%- endfor -%}
        </select>
        <noscript><button type="submit" class="btn btn--small">OK</button></noscript>
      </form>
    {%- endif -%}
    <ul class="product-grid" role="list">
      {%- for p in collection.products -%}
        {%- if forloop.index <= 4 -%}
          <li>{% render 'product-card', card_product: p, show_accroche: true, eager: true %}</li>
        {%- else -%}
          <li>{% render 'product-card', card_product: p, show_accroche: true %}</li>
        {%- endif -%}
      {%- else -%}
        <li class="empty-note">Aucun produit pour l’instant.</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "all_title", "label": "Titre de « Tous les produits »", "default": "Toute la gamme" }
  ]
}
{% endschema %}
