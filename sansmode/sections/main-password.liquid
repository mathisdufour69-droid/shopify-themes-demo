<section class="pw">
  <div class="pw__card">
    {% render 'logo', class: 'pw__logo' %}
    <h1 class="pw__title">{{ section.settings.title }}</h1>
    <p class="pw__text">{{ section.settings.text }}</p>
    {%- form 'storefront_password', class: 'pw__form' -%}
      <label for="Password" class="visually-hidden">Mot de passe</label>
      <div class="news__row">
        <input type="password" name="password" id="Password" class="input" autocomplete="current-password" placeholder="Mot de passe" required {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}>
        <button type="submit" class="btn">Entrer</button>
      </div>
      {%- if form.errors -%}<p class="form-error" id="PasswordError">Mot de passe incorrect.</p>{%- endif -%}
    {%- endform -%}
    <p class="pw__fine">{{ section.settings.fine }}</p>
    <div class="pw__pills" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  </div>
</section>
{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Les bonbons sont en train de cuire." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Boutique de démonstration privée. Entre le mot de passe qu’on t’a transmis pour la visiter." },
    { "type": "text", "id": "fine", "label": "Mention", "default": "SANSMODÉ est une marque fictive. Boutique conçue par Mathis Dufour." }
  ]
}
{% endschema %}
