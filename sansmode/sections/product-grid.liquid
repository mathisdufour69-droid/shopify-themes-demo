{%- assign coll = section.settings.collection | default: collections['all'] -%}
<section class="grid-sec" id="gamme" aria-labelledby="GridTitle-{{ section.id }}">
  <div class="container">
    <div class="sec-head">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 id="GridTitle-{{ section.id }}" class="h2">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="sec-head__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ul class="product-grid" role="list">
      {%- for p in coll.products limit: section.settings.limit -%}
        <li>{% render 'product-card', card_product: p, show_accroche: true %}</li>
      {%- else -%}
        <li class="empty-note">Importe le fichier produits.csv pour remplir la grille.</li>
      {%- endfor -%}
    </ul>
    {%- if coll.products_count > section.settings.limit -%}
      <p class="center"><a href="{{ coll.url }}" class="btn btn--ghost">Voir les {{ coll.products_count }} produits</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Grille produits",
  "class": "section-grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "La gamme" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Choisis ton humeur." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Cinq recettes, cinq nutriments, un seul principe : on en mange autant qu’on veut." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Grille produits" }]
}
{% endschema %}
