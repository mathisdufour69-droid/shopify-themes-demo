{%- comment -%} FAQ en <details> natifs (0 JS) + données structurées FAQPage pour Google. {%- endcomment -%}
<section class="faq" id="faq" aria-labelledby="FaqTitle-{{ section.id }}">
  <div class="container faq__grid">
    <div class="sec-head sec-head--left">
      <p class="kicker">{{ section.settings.kicker }}</p>
      <h2 id="FaqTitle-{{ section.id }}" class="h2">{{ section.settings.title }}</h2>
      <p class="sec-head__text">{{ section.settings.text }}</p>
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="acc" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.question }} {% render 'icon', name: 'plus' %}</summary>
          <div class="acc__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Questions" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Tu te demandes sûrement…" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Une autre question ? On répond en moins de 24 h à bonjour@sansmode.fr." },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "C’est vraiment sans sucres ajoutés ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Oui. La douceur vient uniquement des fruits.</p>" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
