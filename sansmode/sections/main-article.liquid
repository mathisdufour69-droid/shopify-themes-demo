<article class="page-sec">
  <div class="container container--narrow">
    <p class="kicker">{{ article.published_at | date: '%d/%m/%Y' }}</p>
    <h1 class="h2">{{ article.title }}</h1>
    {%- if article.image -%}{{ article.image | image_url: width: 1400 | image_tag: widths: '700,1000,1400', sizes: '(min-width: 800px) 760px, 100vw', class: 'article__img', alt: article.image.alt | default: article.title }}{%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p><a href="{{ blog.url }}" class="link">← Retour au blog</a></p>
  </div>
</article>
{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
