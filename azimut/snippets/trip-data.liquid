        assign exc = 'Vols internationaux||Assurance voyage et annulation||Pourboires'
        assign route = 'Windhoek:420:60||Sossusvlei:200:190||Sesriem:250:150||Swakopmund:90:80||Côte des squelettes:60:30'
        assign months = 'Avr. 27:ok||Mai 27:ok||Juin 27:few||Sept. 27:ok||Oct. 27:ok'
      when 'laponie'
