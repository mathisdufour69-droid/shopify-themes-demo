        assign days = '7'
        assign season = 'décembre à mars'
        assign level = 'Modéré'
        assign group = '2 à 6 voyageurs'
        assign price = '3800'
        assign guide = 'kaisa'
        assign img = 'trip-laponie'
        assign rating = '4.7'
        assign count = '52'
        assign lead = 'Quatre jours d’attelage en autonomie, nuits en cabane chauffée au bois, et deux soirées d’observation avec un astronome de la région.'
        assign intro = 'Une semaine au-dessus du cercle polaire, sans programme fixe : Kaisa choisit l’itinéraire selon la neige du matin. Vous conduisez votre propre attelage dès le deuxième jour.'
        assign hosting = 'Cabanes chauffées au bois'
        assign stages = 'J1::Kiruna::Accueil, équipement grand froid fourni, première nuit en lodge.||J2-5::Quatre jours d’attelage::Vous menez vos chiens d’une cabane à l’autre, repas au feu de bois.||J6::Abisko et le ciel::Soirée d’observation des aurores avec un astronome de la région.||J7::Retour::Sauna, petit-déjeuner tardif, transfert vers Kiruna.'
        assign inc = '6 nuits en lodge et cabanes||Kaisa Lindqvist, guide nordique||Attelage complet et équipement grand froid||Deux soirées avec un astronome||Pension complète||Assistance 24 h/24'
        assign exc = 'Vols internationaux||Assurance voyage et annulation||Pourboires'
        assign route = 'Kiruna:520:200||Cabane 1:420:150||Cabane 2:300:110||Cabane 3:190:80||Abisko:80:50'
        assign months = 'Déc. 26:full||Janv. 27:few||Févr. 27:ok||Mars 27:ok||Nov. 26:ok'
      when 'japon'
        assign country = 'Japon'
        assign title = 'Kyoto et les Alpes japonaises'
        assign place = 'Kyoto, Kamikōchi'
        assign days = '11'
        assign season = 'automne'
        assign level = 'Accessible'
        assign group = '2 à 6 voyageurs'
        assign price = '5600'
        assign guide = ''
        assign img = 'dest-japon'
        assign rating = '4.9'
        assign count = '19'
        assign lead = 'Temples à l’aube avant l’ouverture, puis marche dans les Alpes japonaises de ryokan en ryokan.'
        assign intro = 'Onze jours entre les érables de Kyoto et les sentiers de Kamikōchi. Vous entrez dans les temples avant le public et dormez dans des ryokans de moins de dix chambres.'
        assign hosting = 'Ryokans et maisons de thé'
        assign stages = 'J1-3::Kyoto avant le jour::Visites privées à l’aube, cérémonie du thé chez un maître.||J4-6::La route de Nakasendō::Marche d’auberge en auberge sur l’ancienne route postale.||J7-9::Kamikōchi::Randonnée dans les Alpes japonaises, bains chauds en plein air.||J10-11::Tokyo, retour::Dernière soirée, transfert privé.'
        assign inc = '10 nuits en ryokans et hôtels de caractère||Guide francophone dédié||Transferts privés et pass ferroviaire||Demi-pension||Assistance 24 h/24'
        assign exc = 'Vols internationaux||Assurance voyage et annulation||Pourboires'
        assign route = 'Kyoto:120:190||Nakasendō:240:140||Kamikōchi:330:70||Tokyo:520:130'
        assign months = 'Oct. 27:ok||Nov. 27:few||Avr. 27:ok||Mai 27:ok||Sept. 27:ok'
      when 'canada'
        assign country = 'Canada'
        assign title = 'Rocheuses et lacs glaciaires'
        assign place = 'Banff, Jasper'
        assign days = '9'
        assign season = 'juin à septembre'
        assign level = 'Modéré'
        assign group = '2 à 6 voyageurs'
        assign price = '4300'
        assign guide = ''
        assign img = 'dest-canada'
        assign rating = '4.7'
        assign count = '22'
        assign lead = 'Lacs turquoise, glaciers et forêts sans fin, avec un hydravion pour rejoindre le dernier lodge.'
        assign intro = 'Neuf jours dans les Rocheuses canadiennes, loin des belvédères bondés. Les marches partent tôt, les lodges sont au bord de l’eau, et le dernier se rejoint en hydravion.'
        assign hosting = 'Lodges au bord des lacs'
        assign stages = 'J1-2::Banff::Accueil à Calgary, lac Moraine au lever du soleil.||J3-5::La promenade des Glaciers::Marche sur le champ de glace Columbia, nuits en lodge.||J6-7::Jasper::Canoë sur le lac Maligne, observation de la faune.||J8-9::Lodge en hydravion::Dernière nuit isolée, retour à Calgary.'
        assign inc = '8 nuits en lodges||Guide naturaliste dédié||Véhicule privé et hydravion||Pension complète||Assistance 24 h/24'
        assign exc = 'Vols internationaux||Assurance voyage et annulation||Pourboires'
        assign route = 'Calgary:540:200||Banff:420:150||Glaciers:300:100||Jasper:180:60'
        assign months = 'Juin 27:ok||Juil. 27:few||Août 27:ok||Sept. 27:ok||Mai 27:ok'
      when 'maroc'
        assign country = 'Maroc'
        assign title = 'Erg Chigaga, bivouac mobile'
        assign place = 'M’Hamid, Erg Chigaga'
        assign days = '7'
        assign season = 'octobre à avril'
        assign level = 'Accessible'
        assign group = '2 à 6 voyageurs'
        assign price = '2900'
        assign guide = 'ibrahim'
        assign img = 'dest-maroc'
        assign rating = '4.8'
        assign count = '15'
        assign lead = 'Le grand erg à dos de dromadaire, avec un bivouac mobile monté chaque soir sur une dune différente.'
        assign intro = 'Sept jours au Sahara marocain avec Ibrahim. Le camp avance avec vous, monté chaque soir sur une dune différente, loin des camps fixes.'
        assign hosting = 'Bivouac mobile et riad'
        assign stages = 'J1-2::Marrakech et le Haut Atlas::Accueil, route du Tizi n’Tichka, nuit en kasbah.||J3-5::Erg Chigaga::Marche et dromadaire, bivouac mobile chaque soir.||J6::Le lac Iriki::Traversée du lac asséché en 4x4.||J7::Retour::Route vers Marrakech, dernière nuit en riad.'
        assign inc = '6 nuits en riad, kasbah et bivouac||Ibrahim Ould Sidi, guide de désert||4x4 et chauffeur privés||Pension complète||Assistance 24 h/24'
        assign exc = 'Vols internationaux||Assurance voyage et annulation||Pourboires'
        assign route = 'Marrakech:520:60||Haut Atlas:420:110||M’Hamid:280:170||Erg Chigaga:140:200||Lac Iriki:60:150'
        assign months = 'Oct. 26:ok||Nov. 26:ok||Déc. 26:few||Janv. 27:ok||Févr. 27:ok'
    endcase
    case field
      when 'country'
        echo country
      when 'title'
        echo title
      when 'place'
        echo place
      when 'days'
        echo days
      when 'season'
        echo season
      when 'level'
        echo level
      when 'group'
        echo group
      when 'price'
        echo price
      when 'guide'
        echo guide
      when 'img'
        echo img
      when 'rating'
        echo rating
      when 'count'
        echo count
      when 'lead'
        echo lead
      when 'intro'
        echo intro
      when 'hosting'
        echo hosting
      when 'stages'
        echo stages
      when 'inc'
        echo inc
      when 'exc'
        echo exc
      when 'route'
        echo route
      when 'months'
        echo months
    endcase
  endif
-%}
