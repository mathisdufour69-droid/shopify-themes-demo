        assign route = 'Keflavík:60:120||Vík:220:200||Sólheimajökull:300:150||Jökulsárlón:480:110||Hautes terres:380:50'
        assign months = 'Juin 27:ok||Juil. 27:few||Août 27:ok||Sept. 27:ok||Mai 27:ok'
      when 'namibie'
        assign country = 'Namibie'
        assign title = 'Du désert à la côte des squelettes'
        assign place = 'Sossusvlei, Swakopmund'
        assign days = '10'
        assign season = 'avril à novembre'
        assign level = 'Accessible'
        assign group = '2 à 6 voyageurs'
        assign price = '5200'
        assign guide = 'ibrahim'
        assign img = 'trip-namibie'
        assign rating = '4.8'
        assign count = '27'
        assign lead = 'Dunes au lever du jour, canyon, puis remontée vers l’Atlantique. Véhicule et chauffeur-guide privés du premier au dernier jour.'
        assign intro = 'Dix jours de piste, de silence et de lumière rasante. Ibrahim lit le désert comme une carte : il vous fait partir avant le jour, quand les dunes sont encore froides et que personne n’y est.'
        assign hosting = 'Lodges de moins de dix chambres et camp mobile'
        assign stages = 'J1-2::Windhoek et les hauts plateaux::Accueil, première nuit en lodge sur une réserve privée.||J3-5::Sossusvlei avant le jour::Dune 45 et Deadvlei au lever du soleil, nuit sous les étoiles en camp mobile.||J6-7::Le canyon de Sesriem et Swakopmund::Descente du canyon, puis route vers l’Atlantique.||J8-10::La côte des squelettes::Survol en petit avion, colonies d’otaries, retour à Windhoek.'
