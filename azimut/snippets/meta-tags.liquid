<meta property="og:site_name" content="{{ settings.brand_name | default: 'Azimut' }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
<meta property="og:description" content="{{ page_description | default: shop.description | default: settings.brand_name | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- else -%}
  <meta property="og:image" content="https:{{ 'hero-montagnes-1700.webp' | asset_url }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
