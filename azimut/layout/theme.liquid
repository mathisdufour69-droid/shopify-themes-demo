<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#12120F">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- assign brand = settings.brand_name | default: 'Azimut' -%}
    <title>{% if request.page_type == 'index' %}{{ brand }} · Expéditions privées sur mesure{% else %}{{ page_title }}{% unless page_title contains brand %} · {{ brand }}{% endunless %}{% endif %}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {% render 'meta-tags' %}
    {%- comment -%} Polices auto-hébergées : zéro requête tierce (RGPD), affichage immédiat. {%- endcomment -%}
    {{ 'schibsted-grotesk-latin-wght-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'archivo-latin-wdth-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'instrument-serif-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: 'Schibsted Grotesk'; font-style: normal; font-weight: 400 700; font-display: swap; src: url('{{ 'schibsted-grotesk-latin-wght-normal.woff2' | asset_url }}') format('woff2'); }
      @font-face { font-family: 'Schibsted Grotesk'; font-style: italic; font-weight: 400 700; font-display: swap; src: url('{{ 'schibsted-grotesk-latin-wght-italic.woff2' | asset_url }}') format('woff2'); }
      @font-face { font-family: 'Instrument Serif'; font-style: normal; font-weight: 400; font-display: swap; src: url('{{ 'instrument-serif-latin-400-normal.woff2' | asset_url }}') format('woff2'); }
      @font-face { font-family: 'Archivo'; font-style: normal; font-weight: 100 900; font-stretch: 62% 125%; font-display: swap; src: url('{{ 'archivo-latin-wdth-normal.woff2' | asset_url }}') format('woff2'); }
      @font-face { font-family: 'IBM Plex Mono'; font-style: normal; font-weight: 400; font-display: swap; src: url('{{ 'ibm-plex-mono-latin-400-normal.woff2' | asset_url }}') format('woff2'); }
      @font-face { font-family: 'IBM Plex Mono'; font-style: normal; font-weight: 500; font-display: swap; src: url('{{ 'ibm-plex-mono-latin-500-normal.woff2' | asset_url }}') format('woff2'); }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.className += ' js';</script>
    <script>
      window.Azimut = {
        routes: { cart_add: '{{ routes.cart_add_url }}', cart_change: '{{ routes.cart_change_url }}', cart: '{{ routes.cart_url }}' }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="{% if template.name == 'index' %}home{% else %}inner{% endif %} t-{{ template.name }}">
    <a class="skip" href="#main">Aller au contenu</a>
    {% sections 'header-group' %}
    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}
    {% render 'contact-dialog' %}
  </body>
</html>
