<div class="pw">
  {% render 'picture', base: 'hero-montagnes', widths: '900,1700', width: 1700, height: 953, alt: '', sizes: '100vw', eager: true %}
  <div class="pw-in">
    <span class="logo">{{ settings.brand_name | default: 'Azimut' }}</span>
    <p>{{ section.settings.text }}</p>
    {%- form 'storefront_password' -%}
      <label class="visually-hidden" for="Pw">Mot de passe</label>
      <input id="Pw" type="password" name="password" placeholder="Mot de passe" autocomplete="current-password" required>
      <button type="submit" class="b b-lt">Entrer <span class="d">{% render 'icon', name: 'arrow' %}</span></button>
      {%- if form.errors -%}<p style="color:#F2A27E;margin:12px 0 0;flex-basis:100%">Mot de passe incorrect.</p>{%- endif -%}
    {%- endform -%}
    <p class="fine">{{ section.settings.fine }}</p>
  </div>
</div>
{% schema %}
{ "name": "Mot de passe", "settings": [
  { "type": "textarea", "id": "text", "label": "Texte", "default": "Boutique de démonstration privée. Entrez le mot de passe qu'on vous a transmis." },
  { "type": "text", "id": "fine", "label": "Mention", "default": "Azimut est une marque fictive. Boutique conçue par Mathis Dufour." }
] }
{% endschema %}
