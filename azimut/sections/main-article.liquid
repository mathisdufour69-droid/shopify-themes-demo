<article style="padding:40px 0 90px"><div class="wrap" style="max-width:760px">
  <span class="kick">{{ article.published_at | date: '%d/%m/%Y' }}</span><h1 style="margin:14px 0 24px">{{ article.title }}</h1>
  {%- if article.image -%}{{ article.image | image_url: width: 1400 | image_tag: widths: '700,1400', sizes: '760px', style: 'border-radius:20px', alt: article.title }}{%- endif -%}
  <div class="rte">{{ article.content }}</div>
</div></article>
{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
