{%- paginate collection.products by 24 -%}
<section style="padding-top:40px">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="kick">{% if collection.handle == 'all' or collection.handle == 'voyages' %}Nos voyages{% else %}Collection{% endif %}</span>
        <h1 style="margin-top:14px">{% if collection.handle == 'all' %}{{ section.settings.all_title }}{% else %}{{ collection.title }}{% endif %}</h1>
      </div>
      <p>{{ collection.description | strip_html | default: section.settings.text }}</p>
    </div>
    <div class="trips">
      {%- for p in collection.products -%}
        {%- unless p.gift_card? -%}{% render 'trip-card', trip: p %}{%- endunless -%}
      {%- else -%}
        <p>Aucun itinéraire pour l'instant.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="trips-foot" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Collection", "settings": [
  { "type": "text", "id": "all_title", "label": "Titre", "default": "Sept itinéraires, autant de points de départ." },
  { "type": "textarea", "id": "text", "label": "Texte", "default": "Chacun se reprend, se raccourcit ou se défait entièrement avec un concepteur. Les prix s'entendent par personne, sur la base de deux voyageurs." }
] }
{% endschema %}
