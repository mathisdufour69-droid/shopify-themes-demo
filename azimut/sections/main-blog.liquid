{%- paginate blog.articles by 9 -%}
<section style="padding-top:40px"><div class="wrap">
  <span class="kick">Journal</span><h1 style="margin:14px 0 34px">{{ blog.title }}</h1>
  <div class="blog">{%- for article in blog.articles -%}<a class="post" href="{{ article.url }}"><span class="im">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: widths: '450,900', sizes: '(min-width: 1080px) 31vw, 100vw', loading: 'lazy', alt: article.title }}{%- endif -%}</span><span class="tag">{{ article.tags.first | default: 'Journal' }}</span><h3>{{ article.title }}</h3><small>{{ article.published_at | date: '%d/%m/%Y' }}</small></a>{%- endfor -%}</div>
</div></section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
